# PostgreSQL connection string. Never commit real credentials.
DATABASE_URL="postgresql://kcmsc_app:change-me@localhost:5432/kcmsc_digital_campus?schema=public"

# Generate a cryptographically random secret for the selected auth provider.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Institution configuration
INSTITUTION_NAME="K C Model School & College"
INSTITUTION_TIME_ZONE="Asia/Dhaka"

# Add transactional email and private object-storage credentials only when those integrations are implemented.

# One-time bootstrap account. Set these locally only when running npm run db:seed.
# Use a unique, randomly generated password of at least 16 characters.
BOOTSTRAP_ADMIN_USERNAME="kcmsc-admin"
BOOTSTRAP_ADMIN_EMAIL="replace-with-authorized-admin-email@example.com"
BOOTSTRAP_ADMIN_NAME="KCMSC Administrator"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-random-password-of-16-plus-characters"
